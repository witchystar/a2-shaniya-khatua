library(ggplot2)

# Load data
penguins <- read.csv("penglings.csv")

# Create plot
ggplot(penguins, aes(x = flipper_length_mm, 
                     y = body_mass_g, 
                     color = species, 
                     size = bill_length_mm)) +
  geom_point(alpha = 0.8) +
  scale_size_continuous(range = c(1, 10)) + # Adjust size range to match example
  labs(x = "Flipper Length (mm)", 
       y = "Body Mass (g)") +
  theme_minimal()
